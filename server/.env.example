PORT=3001
NODE_ENV=development

# Credenciales del cliente OAuth de Google (tipo "Aplicacion web"). El redirect
# URI autorizado tiene que ser <URL_API>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base publica de la API, la que Google ve como redirect. Sin barra final.
URL_API=http://localhost:3001/api/v1

# Origenes que pueden pedir a la API y a los que se puede volver tras entrar,
# separados por coma. Vacio en local: se permiten localhost y 127.0.0.1.
ORIGENES_PERMITIDOS=
